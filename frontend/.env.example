# ============================================================
# Frontend (Next.js) — copy to frontend/.env.local (gitignored)
# NEXT_PUBLIC_* vars are inlined at BUILD time. Set them in
# Vercel Project Settings -> Environment Variables too.
# ============================================================

# API origin (Railway api service domain). Used for /api rewrites + direct fetch.
NEXT_PUBLIC_API_BASE=https://api.insidervn.railway.app

# Supabase (Auth) — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
