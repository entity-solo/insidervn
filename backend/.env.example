# ============================================================
# Backend (api + worker) — copy to backend/.env (gitignored)
# ============================================================

# --- Supabase Postgres (Project Settings -> Database -> Connection string) ---
# Use the POOLER URI (port 6543). Replace [YOUR-PASSWORD].
# Code auto-remaps postgres:// -> postgresql:// so either scheme works.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Optional Redis for API response caching (leave empty to disable) ---
REDIS_URL=

# --- CORS: Vercel frontend URL (comma-separated, no trailing slash) ---
CORS_ORIGINS=https://insidervn.vercel.app

# --- Reference data dir (baked into image at /app/reference) ---
SOURCE_DIR=/app/reference

# --- Runtime ---
PORT=8000
PYTHONUNBUFFERED=1
